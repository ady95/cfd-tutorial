__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# OpenFOAM 실행 산출물 (케이스 원본은 0/ constant/ system/ 만 커밋)
processor*/
postProcessing/
log.*
*.foam
**/constant/polyMesh/

# 생성 데이터·모델 (재생성 스크립트로 만든다)
runs/
data/raw/
*.parquet
# 책 04-5 데이터셋은 해석 없이 5장을 따라 하도록 커밋한다
!data/cooling_v1/*.parquet
*.pt
# 책 05-5 최종 대리모델은 6장을 바로 따라 하도록 커밋한다
!models/surrogate_v1/*.pt
*.ckpt
mlruns/
optuna*.db

