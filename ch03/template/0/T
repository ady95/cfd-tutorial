FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField   uniform 293.15;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 293.15;     // 입구 온도 20 °C
    }

    outlet
    {
        type            zeroGradient;
    }

    heatedWall
    {
        // 열유속 q = 10 kW/m2 를 온도 기울기로 준다: q / k = 1e4 / 0.6
        type            fixedGradient;
        gradient        uniform 16666.67;
    }

    ".*Wall"        // 가열하지 않는 벽은 단열
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

